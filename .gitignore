# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual environments (project-local, distinctly named) ---
# NO trailing slash. `.venv-navrl/` matches DIRECTORIES ONLY, so a symlink of that name
# escaped it, was committed by `git add -A`, and on merge git wrote the symlink into the
# checkout pointing at its own path -- replacing the real virtualenv with a self-loop.
.venv-navrl
.venv

# --- Trained models & checkpoints (large binaries; distributed separately) ---
# NOTE: an inline comment must NOT share a line with a pattern -- git treats the
# whole line (spaces + text) as the pattern. Keep comments on their own lines.
*.zip
*.onnx
*.pt
*.pth
checkpoints/
logs/
# A directory exclusion cannot be undone by a later negation -- git will not even descend
# into it -- so the models directory is excluded by CONTENTS, which leaves the one file
# the demo actually needs re-includable below.
experiments/models/*

# The deployed policy is 296 KB and every run instruction in the README depends on it.
# Without it the repo documents a demo nobody else can start.
!experiments/models/ppo_ind_C_s0_full_final.onnx

# --- TensorBoard runs ---
runs/

# --- Experiment outputs (regenerable; keep the dir marker + hand-written .md writeups) ---
experiments/results/*.csv
experiments/results/*.parquet
experiments/results/*.pkl
experiments/results/*.json
!experiments/results/.gitkeep

# --- Media / run logs (never committed) ---
*.mp4
*.gif
*.png
*.jpg
*.jpeg
*.log

# The outputs that ship: the finished 2D demo and the Gazebo recording. Everything else
# here is regenerable from the scripts, and regenerable output does not belong in
# version control.
!experiments/results/final_demo.mp4
!experiments/results/Gazebo_simulation_Demo.mp4

# --- Build artifacts ---
# setuptools writes ./build/ on any `pip install .`; it was committed once from exactly
# that. Top-level, not just the ROS one.
build/
dist/
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
*.bag
rosbags/

# Personal reference notes: kept in the working copy, never in the repo.
docs/IMPLEMENTATION.md

# --- Deliberately not tracked ---
# (README.md was excluded for the initial commit; it is the project's front door now.)
docs/project_summary_CV.md

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
