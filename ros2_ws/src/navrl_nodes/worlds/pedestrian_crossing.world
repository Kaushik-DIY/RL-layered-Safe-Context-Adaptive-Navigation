<?xml version="1.0" ?>
<!-- Gazebo Classic 11 demo world for the sim-to-sim transfer video (Gate G5).
     A short corridor with ONE pedestrian who walks back and forth across the
     robot's straight path (start ~[0,0] -> goal ~[4,0]). The robot must yield.

     The libgazebo_ros_state plugin publishes /gazebo/model_states so
     human_tracker_node sees the actor (name starts with "actor" -> matched).
     The TurtleBot3 (waffle) is spawned separately by the launch file. -->
<sdf version="1.6">
  <world name="pedestrian_crossing">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- publish model states at 20 Hz so the tracker can finite-difference velocity -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>

    <!-- corridor walls (2 m wide), so the pedestrian genuinely crosses the lane -->
    <model name="wall_left">
      <static>true</static>
      <pose>2 1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="wall_right">
      <static>true</static>
      <pose>2 -1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6 0.1 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6 0.1 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient></material></visual>
      </link>
    </model>

    <!-- the crossing pedestrian: walks from one wall to the other across x=2.2,
         looping, at ~0.9 m/s (waypoint spacing / time). Name starts with "actor"
         so human_tracker_node picks it up. -->
    <actor name="actor_pedestrian">
      <skin><filename>walk.dae</filename></skin>
      <animation name="walking"><filename>walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>2.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>2.2 -1.0 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>2.2</time><pose>2.2  1.0 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>2.5</time><pose>2.2  1.0 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>4.7</time><pose>2.2 -1.0 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>5.0</time><pose>2.2 -1.0 0 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <gui><camera name="user_camera"><pose>2 -6 5 0 0.6 1.5708</pose></camera></gui>
  </world>
</sdf>
