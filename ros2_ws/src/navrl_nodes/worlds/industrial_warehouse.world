<?xml version="1.0" ?>
<!-- Gazebo Classic 11 world: INDUSTRIAL warehouse showcase (Gate G5 headline demo).

     A single 24 m mission through THREE distinct hazard types, so one 30 s clip
     shows the supervisor adapting repeatedly rather than reacting once:
       * x ~ 6.25  BLIND CORNER   - worker hidden up a racking aisle, revealed late
       * x ~ 13.25 4-WAY INTERSECTION - worker crosses from the south aisle (visible)
       * x ~ 20.25 BLIND CORNER   - second occluded aisle, different approach speed
     Main corridor y in [-2, 2] (4 m industrial aisle), x in [-1, 25].
     AMR: MiR-class diff-drive, v_max 1.5 m/s, starts (0,0) heading +x, goal (24,0).

     Occlusion note: the tracker hides a worker until it crosses y = occlusion_y (2.0)
     or the AMR closes within reveal_distance, then latches - so the two NORTH aisle
     workers are genuine blind corners, while the SOUTH intersection worker is visible
     as it approaches. That mix is deliberate: it exercises both the anticipatory
     (corner) and reactive (visible-human) halves of the learned policy.

     libgazebo_ros_state publishes /gazebo/model_states (the tracker's input);
     libgazebo_ros_diff_drive gives the AMR /odom + /cmd_vel + odom->base_footprint TF. -->
<sdf version="1.6">
  <world name="industrial_warehouse">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>20.0</update_rate>
    </plugin>

    <!-- ======================= warehouse geometry ======================== -->
    <model name="bot_west">
      <static>true</static><pose>5.750 -2.000 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>13.500 0.120 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>13.500 0.120 1.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="bot_east">
      <static>true</static><pose>19.500 -2.000 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>11.000 0.120 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>11.000 0.120 1.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="aisle_S_w">
      <static>true</static><pose>12.500 -3.250 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.120 2.500 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.120 2.500 1.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="aisle_S_e">
      <static>true</static><pose>14.000 -3.250 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.120 2.500 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.120 2.500 1.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="top_1">
      <static>true</static><pose>2.250 2.000 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>6.500 0.120 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>6.500 0.120 1.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="top_2">
      <static>true</static><pose>9.750 2.000 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>5.500 0.120 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.500 0.120 1.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="top_3">
      <static>true</static><pose>16.750 2.000 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>5.500 0.120 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.500 0.120 1.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="top_4">
      <static>true</static><pose>23.000 2.000 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>4.000 0.120 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.000 0.120 1.2</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient></material></visual>
      </link>
    </model>
    <model name="aisleA_w">
      <static>true</static><pose>5.500 3.250 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.120 2.500 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.120 2.500 1.2</size></box></geometry>
          <material><ambient>0.70 0.50 0.20 1</ambient></material></visual>
      </link>
    </model>
    <model name="aisleA_e">
      <static>true</static><pose>7.000 3.250 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.120 2.500 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.120 2.500 1.2</size></box></geometry>
          <material><ambient>0.70 0.50 0.20 1</ambient></material></visual>
      </link>
    </model>
    <model name="aisleB_w">
      <static>true</static><pose>12.500 3.250 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.120 2.500 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.120 2.500 1.2</size></box></geometry>
          <material><ambient>0.70 0.50 0.20 1</ambient></material></visual>
      </link>
    </model>
    <model name="aisleB_e">
      <static>true</static><pose>14.000 3.250 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.120 2.500 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.120 2.500 1.2</size></box></geometry>
          <material><ambient>0.70 0.50 0.20 1</ambient></material></visual>
      </link>
    </model>
    <model name="aisleC_w">
      <static>true</static><pose>19.500 3.250 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.120 2.500 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.120 2.500 1.2</size></box></geometry>
          <material><ambient>0.70 0.50 0.20 1</ambient></material></visual>
      </link>
    </model>
    <model name="aisleC_e">
      <static>true</static><pose>21.000 3.250 0.6 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.120 2.500 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.120 2.500 1.2</size></box></geometry>
          <material><ambient>0.70 0.50 0.20 1</ambient></material></visual>
      </link>
    </model>
    <model name="rack_n1">
      <static>true</static><pose>2.00 3.40 1.0 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>6.00 1.60 2.0</size></box></geometry>
        <material><ambient>0.45 0.28 0.10 1</ambient><diffuse>0.6 0.38 0.14 1</diffuse></material>
      </visual></link>
    </model>
    <model name="rack_n2">
      <static>true</static><pose>9.70 3.40 1.0 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>4.80 1.60 2.0</size></box></geometry>
        <material><ambient>0.45 0.28 0.10 1</ambient><diffuse>0.6 0.38 0.14 1</diffuse></material>
      </visual></link>
    </model>
    <model name="rack_n3">
      <static>true</static><pose>16.70 3.40 1.0 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>4.80 1.60 2.0</size></box></geometry>
        <material><ambient>0.45 0.28 0.10 1</ambient><diffuse>0.6 0.38 0.14 1</diffuse></material>
      </visual></link>
    </model>
    <model name="rack_n4">
      <static>true</static><pose>23.00 3.40 1.0 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>3.40 1.60 2.0</size></box></geometry>
        <material><ambient>0.45 0.28 0.10 1</ambient><diffuse>0.6 0.38 0.14 1</diffuse></material>
      </visual></link>
    </model>
    <model name="rack_s1">
      <static>true</static><pose>5.00 -3.40 1.0 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>11.00 1.60 2.0</size></box></geometry>
        <material><ambient>0.45 0.28 0.10 1</ambient><diffuse>0.6 0.38 0.14 1</diffuse></material>
      </visual></link>
    </model>
    <model name="rack_s2">
      <static>true</static><pose>19.50 -3.40 1.0 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>10.00 1.60 2.0</size></box></geometry>
        <material><ambient>0.45 0.28 0.10 1</ambient><diffuse>0.6 0.38 0.14 1</diffuse></material>
      </visual></link>
    </model>
    <actor name="actor_worker_A">
      <skin><filename>walk.dae</filename></skin>
      <animation name="walking"><filename>walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop><delay_start>0.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.00</time><pose>6.25 3.80 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>13.20</time><pose>6.25 3.80 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>17.90</time><pose>6.25 -1.60 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>19.40</time><pose>6.25 -1.60 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>19.80</time><pose>6.25 -1.60 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>24.49</time><pose>6.25 3.80 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>25.99</time><pose>6.25 3.80 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>26.39</time><pose>6.25 3.80 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>90.00</time><pose>6.25 3.80 0 0 0 -1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>
    <actor name="actor_worker_B">
      <skin><filename>walk.dae</filename></skin>
      <animation name="walking"><filename>walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop><delay_start>0.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.00</time><pose>13.25 -3.80 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>22.70</time><pose>13.25 -3.80 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>27.40</time><pose>13.25 1.60 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>28.90</time><pose>13.25 1.60 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>29.30</time><pose>13.25 1.60 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>33.99</time><pose>13.25 -3.80 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>35.49</time><pose>13.25 -3.80 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>35.89</time><pose>13.25 -3.80 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>90.00</time><pose>13.25 -3.80 0 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>
    <actor name="actor_worker_C">
      <skin><filename>walk.dae</filename></skin>
      <animation name="walking"><filename>walk.dae</filename><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop><delay_start>0.0</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.00</time><pose>20.25 3.80 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>34.50</time><pose>20.25 3.80 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>39.20</time><pose>20.25 -1.60 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>40.70</time><pose>20.25 -1.60 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>41.10</time><pose>20.25 -1.60 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>45.79</time><pose>20.25 3.80 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>47.29</time><pose>20.25 3.80 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>47.69</time><pose>20.25 3.80 0 0 0 -1.5708</pose></waypoint>
          <waypoint><time>90.00</time><pose>20.25 3.80 0 0 0 -1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ===================== MiR-class diff-drive AMR ===================== -->
    <model name="amr">
      <!-- z MUST equal the wheel radius (0.1) so the drive wheels touch the ground.
           At 0.11 the wheels floated 1 cm and the AMR rode on its frictionless
           casters, so it had no traction and just slid into a wall. -->
      <pose>0 0 0.1 0 0 0</pose>
      <link name="base_footprint">
        <inertial>
          <mass>60.0</mass>
          <inertia><ixx>3.0</ixx><iyy>6.0</iyy><izz>7.0</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <!-- body -->
        <collision name="body_c"><pose>0 0 0.14 0 0 0</pose>
          <geometry><box><size>0.9 0.58 0.3</size></box></geometry></collision>
        <visual name="body_v"><pose>0 0 0.14 0 0 0</pose>
          <geometry><box><size>0.9 0.58 0.3</size></box></geometry>
          <material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.2 0.45 0.9 1</diffuse></material></visual>
        <!-- heading marker so the AMR's facing is legible on camera -->
        <visual name="nose_v"><pose>0.42 0 0.14 0 0 0</pose>
          <geometry><box><size>0.08 0.3 0.12</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient></material></visual>
        <!-- frictionless caster contacts front & rear (diff-drive support) -->
        <collision name="caster_f"><pose>0.35 0 -0.045 0 0 0</pose>
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
        <collision name="caster_r"><pose>-0.35 0 -0.045 0 0 0</pose>
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      </link>

      <!-- The link frame stays UNROTATED and the cylinder is tilted by its geometry
           pose instead. SDF expresses <axis><xyz> in the joint (=child link) frame,
           so a rotated link turned "0 1 0" into a VERTICAL axis: the wheels spun
           like turntables and the AMR never moved. Unrotated link => y is the true
           rolling axis. iyy is therefore the spin inertia. -->
      <link name="left_wheel">
        <pose>0 0.25 0 0 0 0</pose>
        <inertial><mass>1.5</mass>
          <inertia><ixx>0.005</ixx><iyy>0.008</iyy><izz>0.005</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0 -1.5708 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="v"><pose>0 0 0 -1.5708 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.25 0 0 0 0</pose>
        <inertial><mass>1.5</mass>
          <inertia><ixx>0.005</ixx><iyy>0.008</iyy><izz>0.005</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="c"><pose>0 0 0 -1.5708 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="v"><pose>0 0 0 -1.5708 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_footprint</parent><child>left_wheel</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_footprint</parent><child>right_wheel</child>
        <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros><namespace>/</namespace></ros>
        <update_rate>50</update_rate>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.5</wheel_separation>
        <wheel_diameter>0.2</wheel_diameter>
        <max_wheel_torque>200</max_wheel_torque>
        <max_wheel_acceleration>3.0</max_wheel_acceleration>
        <command_topic>cmd_vel</command_topic>
        <odometry_topic>odom</odometry_topic>
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>
      </plugin>
    </model>

    <gui><camera name="user_camera"><pose>10 -14 11 0 0.62 1.32</pose></camera></gui>
  </world>
</sdf>
